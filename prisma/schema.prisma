generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

// ============================================================================
// Enums
// ============================================================================

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum FileStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  AT_RISK
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  MISSED
}

enum NotificationType {
  SYSTEM
  PROJECT
  TASK
  CALENDAR
  AI
  AUTOMATION
  SECURITY
  KNOWLEDGE
  WORKSPACE
}

enum FolderType {
  NOTES
  FILES
  KNOWLEDGE
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  NEEDS_APPROVAL
}

// ============================================================================
// Core Identity Models
// ============================================================================

model User {
  id                      String            @id @default(uuid()) @db.Uuid
  email                   String            @unique
  username                String?           @unique
  passwordHash            String?
  fullName                String?
  avatarUrl               String?
  bio                     String?
  phone                   String?
  company                 String?
  timezone                String?           @default("UTC")
  language                String?           @default("en")
  country                 String?           @default("United States")
  role                    Role              @default(USER)
  isEmailVerified         Boolean           @default(false)
  is2FAEnabled            Boolean           @default(false)
  twoFactorSecret         String?
  twoFactorRecoveryCodes  String[]          @default([])
  lastLoginAt             DateTime?
  passwordLastChangedAt   DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  deletedAt               DateTime?

  // Existing relations
  memberships     WorkspaceMember[]
  projects        Project[]         @relation("ProjectOwner")
  files           File[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  sessions        Session[]
  conversations   Conversation[]
  messages        Message[]
  oauthAccounts   OAuthAccount[]
  feedbacks       Feedback[]

  // New relations
  tasksAssigned   Task[]            @relation("TaskAssignee")
  tasksCreated    Task[]            @relation("TaskCreator")
  taskComments    TaskComment[]
  goals           Goal[]
  calendarEvents  CalendarEvent[]
  settings        UserSettings?
  notes           Note[]
  notebooks       Notebook[]
  folders         Folder[]
  activities      ActivityLog[]
  favorites       UserFavorite[]
  userCalendars   UserCalendar[]
  automations          Automation[]
  automationExecutions AutomationExecution[]
  automationActivities AutomationActivity[]
  aiMemories           AIMemory[]
  agentPlans           AgentPlan[]
  agentExecutions      AgentExecution[]

  @@index([email])
  @@index([username])
  @@map("users")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  refreshToken String    @unique
  expiresAt    DateTime
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

model UserSettings {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  theme              String   @default("dark")
  language           String   @default("en")
  timezone           String   @default("UTC")
  notificationPrefs  Json     @default("{}")
  privacySettings    Json     @default("{}")
  displayPreferences Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ============================================================================
// Workspace Models
// ============================================================================

model Workspace {
  id             String            @id @default(uuid()) @db.Uuid
  name           String
  slug           String            @unique
  description    String?
  logoUrl        String?
  plan           String            @default("free")
  storageUsedMb  Int               @default(0)
  storageLimitMb Int               @default(5120)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  members        WorkspaceMember[]
  projects       Project[]
  knowledge      KnowledgeBase[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// ============================================================================
// Project Management Models
// ============================================================================

model Project {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  description    String?
  workspaceId    String          @db.Uuid
  ownerId        String          @db.Uuid
  status         ProjectStatus   @default(ACTIVE)
  priority       ProjectPriority @default(MEDIUM)
  color          String?
  icon           String?
  category       String?
  tags           String[]        @default([])
  isFavorite     Boolean         @default(false)
  isArchived     Boolean         @default(false)
  startDate      DateTime?
  endDate        DateTime?
  progress       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner          User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  tasks          Task[]
  goals          Goal[]
  milestones     Milestone[]
  calendarEvents CalendarEvent[]

  @@index([workspaceId, ownerId])
  @@index([workspaceId, status])
  @@map("projects")
}

model Task {
  id             String          @id @default(uuid()) @db.Uuid
  projectId      String          @db.Uuid
  workspaceId    String          @db.Uuid
  title          String
  description    String?
  status         TaskStatus      @default(TODO)
  priority       TaskPriority    @default(MEDIUM)
  dueDate        DateTime?
  startDate      DateTime?
  assigneeId     String?         @db.Uuid
  creatorId      String          @db.Uuid
  parentTaskId   String?         @db.Uuid
  labels         String[]        @default([])
  isRecurring    Boolean         @default(false)
  recurringRule  String?
  position       Int             @default(0)
  estimatedHours Float?
  completedAt    DateTime?
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee       User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator        User            @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  parentTask     Task?           @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks       Task[]          @relation("SubTasks")
  comments       TaskComment[]
  attachments    TaskAttachment[]
  calendarEvents CalendarEvent[]

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([workspaceId, creatorId])
  @@index([dueDate])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  userId    String   @db.Uuid
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_comments")
}

model TaskAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  fileId    String   @db.Uuid
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([taskId, fileId])
  @@map("task_attachments")
}

model Goal {
  id          String     @id @default(uuid()) @db.Uuid
  projectId   String?    @db.Uuid
  workspaceId String     @db.Uuid
  userId      String     @db.Uuid
  title       String
  description String?
  targetDate  DateTime?
  progress    Int        @default(0)
  status      GoalStatus @default(NOT_STARTED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId])
  @@index([projectId])
  @@map("goals")
}

model Milestone {
  id          String          @id @default(uuid()) @db.Uuid
  projectId   String          @db.Uuid
  title       String
  description String?
  dueDate     DateTime?
  status      MilestoneStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("milestones")
}

// ============================================================================
// Calendar & Scheduling
// ============================================================================

model CalendarEvent {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  userId      String    @db.Uuid
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  allDay      Boolean   @default(false)
  recurrence  String?
  color       String?
  location    String?
  reminders   Json?
  projectId   String?   @db.Uuid
  taskId      String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([workspaceId, userId])
  @@index([startDate, endDate])
  @@map("calendar_events")
}

// ============================================================================
// AI & Conversations
// ============================================================================

model Conversation {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  projectId   String?   @db.Uuid
  userId      String    @db.Uuid
  title       String    @default("New Conversation")
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([projectId, userId])
  @@index([workspaceId, userId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  senderId       String?      @db.Uuid
  role           String       @default("USER")
  content        String
  tokensUsed     Int?
  metadata       Json?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ============================================================================
// Knowledge Management
// ============================================================================

model KnowledgeBase {
  id          String                 @id @default(uuid()) @db.Uuid
  workspaceId String                 @db.Uuid
  name        String?
  title       String?
  content     String?
  embedding   Unsupported("vector")?
  metadata    Json?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents   Document[]

  @@map("knowledge_base")
}

model Document {
  id              String        @id @default(uuid()) @db.Uuid
  knowledgeBaseId String        @db.Uuid
  fileName        String?
  fileUrl         String?
  content         String?
  status          String        @default("PENDING")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model AIMemory {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  workspaceId    String?   @db.Uuid
  projectId      String?   @db.Uuid
  category       String    @default("FACT")
  content        String
  importance     Float     @default(0.5)
  confidence     String    @default("user_provided")
  source         String?
  scope          String    @default("user")
  status         String    @default("active")
  version        Int       @default(1)
  metadata       Json?
  accessCount    Int       @default(0)
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  expiresAt      DateTime?

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, category])
  @@index([userId, projectId])
  @@index([userId, workspaceId, status])
  @@index([userId, scope, status])
  @@map("ai_memories")
}

model DocumentChunk {
  id          String   @id @default(uuid()) @db.Uuid
  documentId  String?  @db.Uuid
  workspaceId String?  @db.Uuid
  projectId   String?  @db.Uuid
  userId      String   @db.Uuid
  content     String
  tokenCount  Int      @default(0)
  chunkIndex  Int      @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([workspaceId, userId])
  @@index([documentId])
  @@index([projectId])
  @@map("document_chunks")
}

model Note {
  id                String    @id @default(uuid()) @db.Uuid
  workspaceId       String    @db.Uuid
  userId            String    @db.Uuid
  title             String    @default("Untitled Note")
  content           String?
  formattedContent  String?
  category          String?   @default("General")
  isPinned          Boolean   @default(false)
  isFavorite        Boolean   @default(false)
  isArchived        Boolean   @default(false)
  isQuickNote       Boolean   @default(false)
  order             Int       @default(0)
  tags              String[]  @default([])
  attachmentIds     String[]  @default([])
  sharedWithUserIds String[]  @default([])
  aiSummary         String?
  notebookId        String?   @db.Uuid
  sectionId         String?   @db.Uuid
  folderId          String?   @db.Uuid
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder   Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  notebook Notebook? @relation(fields: [notebookId], references: [id], onDelete: SetNull)
  section  Section?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, userId])
  @@index([notebookId])
  @@index([sectionId])
  @@map("notes")
}

model Notebook {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  name        String
  description String?
  color       String?   @default("indigo")
  order       Int       @default(0)
  isDefault   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections Section[]
  notes    Note[]

  @@index([userId])
  @@map("notebooks")
}

model Section {
  id         String    @id @default(uuid()) @db.Uuid
  notebookId String    @db.Uuid
  userId     String    @db.Uuid
  name       String
  order      Int       @default(0)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  notebook Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  notes    Note[]

  @@index([notebookId])
  @@index([userId])
  @@map("sections")
}

model Folder {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @db.Uuid
  userId      String     @db.Uuid
  name        String
  parentId    String?    @db.Uuid
  type        FolderType @default(FILES)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent      Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Folder[]   @relation("FolderTree")
  notes       Note[]
  files       File[]

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId])
  @@map("folders")
}

// ============================================================================
// File Storage
// ============================================================================

model File {
  id          String           @id @default(uuid()) @db.Uuid
  filename    String
  mimeType    String
  size        Int
  storagePath String
  status      FileStatus       @default(PENDING)
  userId      String           @db.Uuid
  workspaceId String?          @db.Uuid
  projectId   String?          @db.Uuid
  folderId    String?          @db.Uuid
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder      Folder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  attachments TaskAttachment[]

  @@index([userId])
  @@index([workspaceId])
  @@map("files")
}

// ============================================================================
// Notifications & Activity & Search
// ============================================================================

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  metadata  Json?
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  resource  String
  payload   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  action      String
  entityType  String
  entityId    String   @db.Uuid
  entityName  String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([userId])
  @@map("activity_logs")
}

model SearchIndex {
  id          String   @id @default(uuid()) @db.Uuid
  entityType  String
  entityId    String   @db.Uuid
  workspaceId String   @db.Uuid
  title       String
  content     String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId, entityType])
  @@index([workspaceId])
  @@map("search_index")
}

// ============================================================================
// Automation
// ============================================================================

model Automation {
  id          String               @id @default(uuid()) @db.Uuid
  workspaceId String               @db.Uuid
  userId      String?              @db.Uuid
  name        String
  description String?
  trigger     String               @default("manual")
  conditions  Json?
  actions     Json?
  schedule    String?
  isEnabled   Boolean              @default(true)
  status      AutomationStatus     @default(ACTIVE)
  lastRunAt   DateTime?
  runCount    Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?

  user        User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  executions  AutomationExecution[]
  activities  AutomationActivity[]

  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("automations")
}

model AutomationExecution {
  id           String           @id @default(uuid()) @db.Uuid
  automationId String           @db.Uuid
  workspaceId  String           @db.Uuid
  userId       String?          @db.Uuid
  status       AutomationStatus @default(RUNNING)
  triggerData  Json?
  currentStep  Int              @default(0)
  stepResults  Json?
  result       Json?
  error        Json?
  retryCount   Int              @default(0)
  startedAt    DateTime         @default(now())
  completedAt  DateTime?

  automation   Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  activities   AutomationActivity[]

  @@index([automationId])
  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@index([startedAt])
  @@map("automation_executions")
}

model AutomationActivity {
  id           String               @id @default(uuid()) @db.Uuid
  automationId String               @db.Uuid
  executionId  String?              @db.Uuid
  workspaceId  String               @db.Uuid
  userId       String?              @db.Uuid
  type         String
  message      String
  metadata     Json?
  createdAt    DateTime             @default(now())

  automation   Automation           @relation(fields: [automationId], references: [id], onDelete: Cascade)
  execution    AutomationExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([automationId])
  @@index([executionId])
  @@index([workspaceId])
  @@index([userId])
  @@index([createdAt])
  @@map("automation_activities")
}


// ============================================================================
// User Favorites (persistent, any resource type)
// ============================================================================

model UserFavorite {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  workspaceId  String?  @db.Uuid
  resourceType String   // e.g. "project" | "file" | "conversation" | "model"
  resourceId   String   // ID of the favorited resource
  title        String
  metadata     Json?    // optional extra info (color, icon, url, etc.)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceType, resourceId])
  @@index([userId])
  @@index([userId, workspaceId])
  @@map("user_favorites")
}

// ============================================================================
// User Calendars (persistent calendar categories per user)
// ============================================================================

model UserCalendar {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  workspaceId String?  @db.Uuid
  title       String
  color       String   @default("#38bdf8")
  isPrimary   Boolean  @default(false)
  isVisible   Boolean  @default(true)
  description String?
  timeZone    String   @default("UTC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_calendars")
}

// ============================================================================
// Feedback & Support Submissions
// ============================================================================

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

model Feedback {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String?        @db.Uuid
  name      String
  email     String
  category  String
  subject   String
  message   String
  status    FeedbackStatus @default(NEW)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("feedbacks")
}

// ============================================================================
// Agent Reasoning & Planning Models (Prompt 7)
// ============================================================================

model AgentPlan {
  id                String                 @id @default(uuid()) @db.Uuid
  version           Int                    @default(1)
  userId            String                 @db.Uuid
  workspaceId       String?                @db.Uuid
  projectId         String?                @db.Uuid
  conversationId    String?                @db.Uuid
  correlationId     String
  status            String                 @default("DRAFT")
  goal              Json
  constraints       Json                   @default("[]")
  assumptions       Json                   @default("[]")
  confidence        Float?
  planHash          String?
  requiresUserInput Boolean                @default(false)
  metadata          Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps             AgentPlanStep[]
  dependencies      AgentPlanDependency[]

  @@index([userId, status])
  @@index([workspaceId, userId])
  @@index([correlationId])
  @@map("agent_plans")
}

model AgentPlanStep {
  id                   String     @id @default(uuid()) @db.Uuid
  planId               String     @db.Uuid
  order                Int
  title                String
  description          String
  type                 String     @default("TOOL")
  toolName             String?
  toolVersion          String?
  input                Json?
  expectedOutcome      String?
  requiresConfirmation Boolean    @default(false)
  status               String     @default("PENDING")
  createdAt            DateTime   @default(now())

  plan                 AgentPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, order])
  @@map("agent_plan_steps")
}

model AgentPlanDependency {
  id              String     @id @default(uuid()) @db.Uuid
  planId          String     @db.Uuid
  stepId          String
  dependsOnStepId String
  type            String     @default("BLOCKS")
  createdAt       DateTime   @default(now())

  plan            AgentPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("agent_plan_dependencies")
}


// ============================================================================
// Agent Execution Models (Prompt 8)
// ============================================================================

enum AgentExecutionStatus {
  PENDING
  VALIDATING
  AUTHORIZED
  RUNNING
  WAITING_FOR_INPUT
  WAITING_FOR_APPROVAL
  VERIFYING
  RECOVERING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  TIMED_OUT
  CANCELLED
  BLOCKED
}

enum AgentExecutionStepStatus {
  PENDING
  RUNNING
  WAITING_FOR_INPUT
  WAITING_FOR_APPROVAL
  VERIFYING
  COMPLETED
  FAILED
  TIMED_OUT
  CANCELLED
  BLOCKED
  SKIPPED
}

model AgentExecution {
  id                  String                 @id @default(uuid()) @db.Uuid
  planId              String                 @db.Uuid
  planVersion         Int
  planHash            String
  correlationId       String
  handoffId           String?
  userId              String                 @db.Uuid
  workspaceId         String?                @db.Uuid
  projectId           String?                @db.Uuid
  conversationId      String?                @db.Uuid
  status              AgentExecutionStatus   @default(PENDING)
  currentStepId       String?
  completedStepIds    String[]               @default([])
  failedStepIds       String[]               @default([])
  blockedStepIds      String[]               @default([])
  failureReason       String?
  failureCategory     String?
  replanningRequired  Boolean                @default(false)
  previousExecutionId String?                @db.Uuid
  idempotencyKey      String?                @unique
  totalSteps          Int                    @default(0)
  completedStepsCount Int                    @default(0)
  failedStepsCount    Int                    @default(0)
  metadata            Json?
  startedAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  completedAt         DateTime?

  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps               AgentExecutionStep[]

  @@index([userId, status])
  @@index([workspaceId, userId])
  @@index([projectId])
  @@index([planId])
  @@index([correlationId])
  @@index([status])
  @@index([startedAt])
  @@map("agent_executions")
}

model AgentExecutionStep {
  id                  String                      @id @default(uuid()) @db.Uuid
  executionId         String                      @db.Uuid
  stepId              String
  planStepOrder       Int
  title               String
  description         String
  toolName            String?
  toolVersion         String?
  idempotencyKey      String?
  status              AgentExecutionStepStatus    @default(PENDING)
  attemptCount        Int                         @default(0)
  maxAttempts         Int                         @default(3)
  input               Json?
  toolResult          Json?
  verified            Boolean?
  verificationStatus  String?
  verificationDetails String?
  failureReason       String?
  failureCategory     String?
  startedAt           DateTime?
  completedAt         DateTime?
  durationMs          Float?

  execution           AgentExecution              @relation(fields: [executionId], references: [id], onDelete: Cascade)
  attempts            AgentExecutionAttempt[]

  @@unique([executionId, stepId])
  @@index([executionId])
  @@index([executionId, status])
  @@map("agent_execution_steps")
}

model AgentExecutionAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  stepId      String   @db.Uuid
  attempt     Int
  status      String
  toolResult  Json?
  error       String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  durationMs  Float?

  step        AgentExecutionStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([stepId, attempt])
  @@index([stepId])
  @@map("agent_execution_attempts")
}

