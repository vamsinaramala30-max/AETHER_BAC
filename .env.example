# Application
NODE_ENV=development
PORT=5001
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_NAME=AETHER_Backend

DATABASE_URL="postgresql://user:password@localhost:5432/aether_db"
DIRECT_URL="postgresql://user:password@localhost:5432/aether_db"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication
JWT_SECRET=your-jwt-secret-key
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key
SESSION_SECRET=your-session-secret-key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# AI Multi-Provider Configuration
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=openai
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2
LOCAL_LLM_TIMEOUT=120000

# CORS & Rate Limiting
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info
