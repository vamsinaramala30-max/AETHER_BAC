# Application
NODE_ENV=development
PORT=5001
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_NAME=AETHER_Backend

DATABASE_URL="postgresql://user:password@localhost:5432/aether_db"
DIRECT_URL="postgresql://user:password@localhost:5432/aether_db"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication
JWT_SECRET=your-jwt-secret-key-at-least-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key
SESSION_SECRET=your-session-secret-key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Resend Email Service
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="AETHER Platform <onboarding@resend.dev>"
CONTACT_EMAIL=vkgroups127@gmail.com

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=aether-uploads

# AI Configuration
AI_PRIMARY_PROVIDER=aether
AI_FALLBACK_PROVIDER=none
AETHER_MODEL_BASE_URL=http://localhost:5002
AETHER_MODEL_URL=http://localhost:5002

# CORS & Frontend URLs
CORS_ORIGIN=http://localhost:5174
FRONTEND_URL=http://localhost:5174
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
